rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bảng xếp hạng công khai ở chế độ Production:
    // - Ai cũng đọc được BXH
    // - Chỉ cho tạo/cập nhật bản ghi đúng định dạng, không cho phép giảm điểm hoặc xóa
    match /game_leaderboard/{playerId} {
      allow read: if true;

      allow create: if playerId.size() >= 6 && playerId.size() <= 64
        && request.resource.data.keys().hasAll([
          'id', 'playerName', 'score', 'wave', 'kills', 'victory', 'gamesPlayed', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'playerName', 'score', 'wave', 'kills', 'victory', 'gamesPlayed', 'updatedAt'
        ])
        && request.resource.data.id == playerId
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() >= 1
        && request.resource.data.playerName.size() <= 24
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.wave is number
        && request.resource.data.wave >= 1
        && request.resource.data.wave <= 99
        && request.resource.data.kills is number
        && request.resource.data.kills >= 0
        && request.resource.data.victory is bool
        && request.resource.data.gamesPlayed is number
        && request.resource.data.gamesPlayed >= 1
        && request.resource.data.updatedAt is number;

      allow update: if request.resource.data.keys().hasAll([
          'id', 'playerName', 'score', 'wave', 'kills', 'victory', 'gamesPlayed', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'playerName', 'score', 'wave', 'kills', 'victory', 'gamesPlayed', 'updatedAt'
        ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() >= 1
        && request.resource.data.playerName.size() <= 24
        && request.resource.data.score is number
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= 10000000
        && request.resource.data.wave is number
        && request.resource.data.wave >= resource.data.wave
        && request.resource.data.wave <= 99
        && request.resource.data.kills is number
        && request.resource.data.kills >= resource.data.kills
        && request.resource.data.victory is bool
        && (request.resource.data.victory == true || resource.data.victory == false)
        && request.resource.data.gamesPlayed is number
        && request.resource.data.gamesPlayed >= resource.data.gamesPlayed
        && request.resource.data.updatedAt is number;

      allow delete: if false;
    }

    // Chặn toàn bộ các collection khác theo chuẩn Production
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
